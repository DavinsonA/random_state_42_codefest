# Gateway de modelos del evento (OpenAI-compatible). NUNCA commitear .env real.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Indice vectorial: se monta, no se versiona.
VECTOR_INDEX_PATH=data/base_vectorial/encoder_bge_m3

# Modo de la aplicacion: "stub" (datos simulados, sin indice ni gateway) o
# "live" (comportamiento real). Por defecto "stub" para poder desplegar antes
# de tener corpus, credenciales o reto definido.
ARPIA_MODE=stub

# Limites operativos
MAX_AGENT_ITERATIONS=6
REQUEST_TIMEOUT_S=60
LOG_LEVEL=INFO
