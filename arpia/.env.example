# Gateway de modelos del evento (OpenAI-compatible). NUNCA commitear .env real.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Indice vectorial: se monta, no se versiona.
VECTOR_INDEX_PATH=data/encoder_bge_m3

# De donde baja el indice si falta al arrancar. Lista de `nombre=url` separados
# por espacios, que lee `descargar_indice.py` desde `entrypoint.sh`. Vacio en
# local (el indice ya esta en data/); en Coolify se configura para que el
# contenedor se traiga solo el indice y no dependa de un scp manual.
DATA_FILES=

# Agent card (entregable del Reto 1). Por defecto, la raiz del proyecto.
AGENT_CARD_PATH=agent_card.json

# Memoria conversacional del grafo. Ruta ESCRIBIBLE y separada de data/,
# que se monta en solo lectura. Si no se puede escribir, la memoria cae a
# RAM y se pierde en cada redespliegue (lo reporta GET /health).
CHECKPOINT_PATH=state/checkpoints.sqlite

# Modo de la aplicacion:
#   stub -> datos SIMULADOS, sin indice ni gateway. Cero tokens. Solo desarrollo.
#   live -> comportamiento real.
#
# EL DESPLIEGUE EVALUADO DEBE CORRER EN "live". RETO.md prohibe datos simulados
# en la version desplegada. Si queda en "stub", el endpoint responde 200 con
# forma perfecta y contenido inventado: se ve en `mode`, en `metadata.estado`
# y en `GET /health` (status="degraded"). Revisar eso ANTES de las 08:00.
ARPIA_MODE=stub

# Publica GET /api/trace, que devuelve el texto de las preguntas, los
# fragmentos recuperados y la salida del modelo. SOLO desarrollo: en el
# despliegue evaluado se deja vacio.
ARPIA_DEBUG_TRACE=

# Traduccion de los nombres de la agent card a los ids que acepta LiteLLM,
# como JSON. Vacio usa el mapa por defecto de src/agents/card.py. Existe
# para poder corregir un id desde Coolify sin tocar codigo.
MODEL_ALIASES=

# Limites operativos
# Vigencia de la cookie de sesion que el servidor emite cuando el cliente no
# manda ninguna (ver src/api/session.py).
SESSION_TTL_S=3600
# Timeout por llamada al gateway. El peor caso de un turno son tres
# llamadas y el frontend abandona a los 90 s: 3x25 + recuperacion cabe.
REQUEST_TIMEOUT_S=25

# Presupuesto total del turno. Al agotarse no se empieza nada caro nuevo y
# se responde con la evidencia ya recuperada (ver src/agents/budget.py).
TURN_BUDGET_S=75
LOG_LEVEL=INFO
