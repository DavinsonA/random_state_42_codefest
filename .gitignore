# Entornos y caches de Python (aplica a arpia/ y arpia-bundle/)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ropeproject

# Secretos y configuracion local
.env
.streamlit/secrets.toml

# Estado mutable en ejecucion: memoria conversacional del grafo
state/
*.sqlite
*.sqlite3

# Datos e indices: se montan, no se versionan
data/
!data/.gitkeep
*.faiss
*.jsonl

# Documentos ---
docs/
# Excepcion a `docs/` (linea 25). Esa regla estaba pensada para docs generados,
# pero se lleva por delante dos cosas que son entregables de la Especificacion:
# el documento de arquitectura (§1.4) y el material del pitch. Ademas
# `src/theme/tokens.py` lee `docs/design/design-tokens.json` en tiempo de
# ejecucion: lo que no esta en el repositorio no llega al contenedor.
!arpia/docs/
!arpia/docs/**
!arpia-bundle/docs/
!arpia-bundle/docs/**
